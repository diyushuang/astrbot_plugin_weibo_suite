# 虚拟环境与构建产物
.venv/
build/
dist/
*.egg-info/

# Python 缓存
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# 测试与覆盖率
.coverage
htmlcov/
pytest.log
.pytest-of-*/

# 本地工具与编辑器
.mimosa/
.workbuddy/
.trae-html-share-packages/
.screenshots/
_scratch/
_selftest/
_tools/
.pytest-tmp/
_tmp_pytest_run/
.tmp-sns-pytest/
.vscode/
.idea/

# 运行时数据（绝不入库：含用户 cookie、会话、归档与文案原文）
data/plugin_data/
# AstrBot core 初始化会在工作目录建 data/（cmd_config.json、t2i_templates/ 等）。
# 装了真 astrbot 后跑 pytest 就会重建，属于纯副作用，不入库。
# 必须写成 /data/* 而非 /data/：Git 不会进入被整体排除的目录，
# 目录一旦被排除，后面的 !/data/xxx 否定规则永远无效（check-ignore --no-index 可复现）。
/data/*
# 但以下两个文件必须随发布包分发（emoji-props.json 缺失会导致清洗功能崩溃），
# 否定规则必须写在 /data/* 之后才生效。
!/data/.gitkeep
!/data/emoji-props.json
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.db-journal
# 运行日志目录（含抓取明细与报错堆栈）
logs/
# 微博文案导出目录：内容是真实文案原文，属于用户隐私
copylib/

# 凭据与会话（任何一份都可能被直接拿去登录）
.env
.env.*
!.env.example
*.log
*_cookie*.json
cookie*.json
credentials*.json
sessions*.json
sns_state.json
state.json
**/sns_data/
# 私钥类凭据（RSA / PEM / 各类 .key 文件）
*.pem
*.key
id_rsa*

# Windows 设备名文件：在 Git Bash 里写 `2>NUL` 会在仓库根凭空造出一个名叫 NUL
# 的普通文件，而 Win32 又按设备名解析它——`git add -A` 会报
# "short read while indexing NUL" 并让整次暂存失败，删也删不掉。
NUL
CON
PRN
AUX
