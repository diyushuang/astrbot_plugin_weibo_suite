root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,js,css,html}]
indent_size = 2

[*.md]
# Markdown 里行尾两个空格是硬换行语义，不能自动删。
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
